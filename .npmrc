# Supply-chain hardening for every npm command in this repo (local and CI).

# Never run dependency lifecycle scripts (preinstall/install/postinstall/prepare). Nothing in this repo needs them.
# Explicit `npm run <script>` commands still work.
ignore-scripts=true

# Only resolve versions published at least 7 days ago, so a compromised release is usually caught before we pick it
# up. Applies when versions are resolved (npm install/update/npx); `npm ci` installs exactly the lockfile.
min-release-age=7

# No dependencies straight from git repositories (they bypass the registry and can run `prepare` scripts).
allow-git=none
